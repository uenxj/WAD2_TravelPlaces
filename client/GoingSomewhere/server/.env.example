# Copy to server/.env (which Git ignores) and fill in the real values. Never commit server/.env.
# Shared team database. Used by the budget planner, the checklist and accounts.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=goingsomewhere

# Optional. Only if your network cannot resolve mongodb+srv:// addresses ("querySrv ECONNREFUSED").
# MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# Itinerary planner: the "Suggested places" panel. Free key from https://dev.opentripmap.org
# (non-commercial, 5,000 requests/day). Leave it out and only that panel is switched off.
OPENTRIPMAP_KEY=
